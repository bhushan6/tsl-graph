# Reference for .env.local, which the Next.js app reads. `npx convex dev`
# writes the three Convex values there for you; add the others yourself.

CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Same deployment, but the .convex.site domain (serves the auth HTTP routes).
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Optional. Leave empty to disable analytics.
NEXT_PUBLIC_POSTHOG_KEY=

# The variables below are NOT read from this file. They live on the Convex
# deployment; set each one with `npx convex env set NAME value`:
#
#   SITE_URL              http://localhost:3000 (your app's public URL in production)
#   BETTER_AUTH_SECRET    any long random string, e.g. `openssl rand -base64 32`
#   GOOGLE_CLIENT_ID      from a Google OAuth client
#   GOOGLE_CLIENT_SECRET
#   GITHUB_CLIENT_ID      from a GitHub OAuth app
#   GITHUB_CLIENT_SECRET
